# Backend profiles -----------------------------------------------------------
# Dev (default): runs with zero external services.
EMBEDDER=hash             # hash | bge
VECTOR_STORE=memory       # memory | qdrant
RERANKER=noop             # noop | bge
LLM_PROFILE=stub          # stub | claude | vllm

# Production example -----------------------------------------------------------
# EMBEDDER=bge
# VECTOR_STORE=qdrant
# RERANKER=bge
# LLM_PROFILE=claude          # or: vllm (air-gapped Llama 3.3)

# Qdrant ----------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb

# Retrieval / generation knobs ------------------------------------------------
KB_VERSION=kb_v1
RETRIEVE_K=20
RERANK_TOP_N=6
RELEVANCE_FLOOR=0.15
MIN_SUPPORTING=1

# Security / ops --------------------------------------------------------------
AUTH_ENABLED=false
RATE_LIMIT_PER_MIN=60
AUDIT_PATH=data/audit/audit.jsonl

# Secrets (never commit real values) ------------------------------------------
ANTHROPIC_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
